<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 9+ blocks cleartext HTTP by default. The local report receiver and the APK server speak
  plain HTTP on the LAN, so cleartext is permitted only for the private address ranges — a global
  `usesCleartextTraffic` flag would also open the whole public internet.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.0.139</domain>
        <domain includeSubdomains="true">192.168.0.1</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
